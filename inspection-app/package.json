{
  "name": "gotutors-inspection",
  "version": "0.1.0",
  "private": true,
  "description": "GoTutors centre inspection app — runs standalone, with its own database.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "prisma generate && next build",
    "start": "next start -p 3100 --keepAliveTimeout 65000",
    "lint": "eslint .",
    "test": "vitest run && node --test core/",
    "test:watch": "vitest",
    "test:core": "node --test core/",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "uploads:gc": "tsx scripts/gc-uploads.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/client-sesv2": "^3.1121.0",
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "^4.8.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "next": "^16.3.3",
    "next-auth": "^4.24.10",
    "nodemailer": "^9.0.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.11",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    }
  }
}
