// GoTutors Inspection — Prisma schema
//
// This app owns its own database. It shares nothing with the Academy LMS in the
// rest of this repository: its own users, its own centres, its own connection.
// See docs/BACKEND-HANDOFF.md for the original specification.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The roles in the handoff. Access is checked against these directly — there is
/// no separate permission table, because the six roles differ only in reach.
enum Role {
  SUPER_ADMIN
  HEAD_OFFICE
  REGIONAL_MANAGER
  FRANCHISEE
  /// Runs one or more centres. Reads the inspections of their own centres and
  /// nothing else; never carries one out.
  CENTRE_HEAD
  INSPECTOR
  READ_ONLY
}

enum CentreSize {
  SMALL
  MEDIUM
  LARGE
}

enum CentreStatus {
  OPEN
  CLOSED
}

enum InspectionQuestionType {
  RATING
  YESNO
  SCALE
  NUMBER
  CHOICE
}

enum InspectionStatus {
  DRAFT
  SUBMITTED
}

/// Which part of the report an answered question lands in. Computed by the core
/// from the answer *and* the inspection's centre size — never store one without it.
enum Bucket {
  WELL
  IMPROVE
  OBS
  SKIP
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  password    String
  name        String
  role        Role      @default(INSPECTOR)
  /// Centres this person is responsible for — a regional manager, a franchisee
  /// or a head of centre. This is what they may read.
  centres     Centre[]  @relation("CentreManagers")
  /// Centres an inspector is expected to visit. Separate from `centres` on
  /// purpose: this says where their work is, not what they may read. An
  /// inspector can still be sent elsewhere, so it never narrows access.
  assignedCentres Centre[] @relation("CentreInspectors")
  active      Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  inspections Inspection[]
  deliveries  ReportDelivery[]
  visits        ScheduledVisit[] @relation("VisitInspector")
  visitsBooked  ScheduledVisit[] @relation("VisitCreator")
  visitsMarked  ScheduledVisit[] @relation("VisitStatusSetter")
  uploads       Upload[]

  @@index([role])
}

model Centre {
  id        String       @id @default(cuid())
  name      String       @unique
  address   String?
  status    CentreStatus @default(OPEN)
  /// Default size for inspections here. Drives the size-based minimums and
  /// guidance in the checklist; an inspector may override it for a given visit.
  size      CentreSize?
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  managers    User[]       @relation("CentreManagers")
  inspectors  User[]       @relation("CentreInspectors")
  inspections Inspection[]
  visits      ScheduledVisit[]

  @@index([status, sortOrder])
}

model Template {
  id          String     @id @default(cuid())
  name        String
  version     Int        @default(1)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  sections    Section[]
  inspections Inspection[]

  @@unique([name, version])
  @@index([isActive])
}

model Section {
  id         String     @id @default(cuid())
  templateId String
  title      String
  order      Int

  template  Template   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  questions Question[]

  @@unique([templateId, order])
  @@index([templateId])
}

model Question {
  id          String                 @id @default(cuid())
  sectionId   String
  text        String
  type        InspectionQuestionType @default(RATING)
  order       Int
  /// choice: the selectable options, best-first when `scored`
  options     Json?
  /// scale bounds
  minVal      Int?
  maxVal      Int?
  /// number: what is being counted ("books", "passes")
  unit        String?
  /// a multiple choice that counts toward the score, first option best
  scored      Boolean                @default(false)
  requireNote Boolean                @default(false)
  /// failing this caps the whole inspection at "Serious finding"
  critical    Boolean                @default(false)
  /// a critical item evidenced in writing, not by photo (e.g. DBS records)
  photoExempt Boolean                @default(false)
  allowNA     Boolean                @default(false)
  /// each note entry carries a tutor name (the Teaching Observation sections)
  whoField    Boolean                @default(false)
  guide       String?
  /// green "do" bullets
  dos         Json?
  /// red "don't" bullets
  donts       Json?
  /// { small: { text }, medium: { text }, large: { text } }
  sizeGuide   Json?
  /// { small, medium, large } — a count below the target is flagged "improve"
  minBySize   Json?
  /// "standups" | "distractions" — driven by the session tally bar
  tallyKey    String?

  section Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@unique([sectionId, order])
  @@index([sectionId])
}

model Inspection {
  id          String           @id @default(cuid())
  centreId    String
  templateId  String
  inspectorId String
  /// the size used for THIS inspection — the centre default is a starting point
  size        CentreSize
  date        DateTime         @db.Date
  startedAt   DateTime?
  endedAt     DateTime?
  /// accumulated ACTIVE milliseconds; the clock pauses when the inspector leaves
  activeMs    Int              @default(0)
  status      InspectionStatus @default(DRAFT)
  scorePct    Int?
  verdict     String?
  targets     String?

  debriefRole         String?
  debriefName         String?
  debriefNotes        String?
  debriefFeedback     String?
  debriefEmail        String?
  debriefSignatureUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  centre     Centre           @relation(fields: [centreId], references: [id])
  template   Template         @relation(fields: [templateId], references: [id])
  inspector  User             @relation(fields: [inspectorId], references: [id])
  answers    Answer[]
  deliveries ReportDelivery[]
  visit      ScheduledVisit?

  @@index([centreId, date])
  @@index([inspectorId])
  @@index([status])
}

model Answer {
  id            String  @id @default(cuid())
  inspectionId  String
  questionId    String
  /// snapshot of the question at answer time — the template may change later
  questionText  String
  /// "pass" | "yes" | "3" | "7" | "Positive" | "na" | null
  answer        String?
  /// from the core's itemScore, kept for analytics
  scoreFraction Float?
  bucket        Bucket?

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id])
  entries    Entry[]

  @@unique([inspectionId, questionId])
  @@index([inspectionId])
  @@index([questionText, bucket])
}

/// Layered notes: one question can hold several entries, each tagged with the
/// tutor it came from and carrying its own photos.
model Entry {
  id       String  @id @default(cuid())
  answerId String
  note     String?
  /// tutor name, for whoField questions
  who      String?
  order    Int     @default(0)

  answer Answer  @relation(fields: [answerId], references: [id], onDelete: Cascade)
  photos Photo[]

  @@index([answerId])
}

/// A file put into object storage: who uploaded it, and where it went.
///
/// Photos are attached to an entry by a later autosave, so between the upload
/// and that save the file belongs to nobody — this row is what lets the person
/// who took the photo see their own preview before it is attached to anything.
/// It also gives orphaned objects a handle: an upload with no Photo and no
/// signature pointing at it is uncollected, and can be swept.
model Upload {
  /// object key, e.g. "photos/<32 hex>.jpg" — the path under the store's root
  key          String   @id
  kind         String
  contentType  String
  bytes        Int
  /// "local" or "s3": where the bytes actually went, so a store that was
  /// switched over mid-life can still find the old ones.
  backend      String
  uploadedById String
  createdAt    DateTime @default(now())

  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([uploadedById, createdAt])
  @@index([createdAt])
}

model Photo {
  id      String   @id @default(cuid())
  entryId String
  url     String
  takenAt DateTime @default(now())

  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
}

enum VisitStatus {
  PLANNED
  DONE
  MISSED
  CANCELLED
}

/// An inspector booked to visit a centre on a particular day.
///
/// Separate from the standing `Centre.inspectors` assignment, which says where
/// someone's work generally is. This is one date, one centre, one person — the
/// thing an inspector opens the app to see, and the thing head office looks at
/// to know a visit was actually made.
///
/// `inspectionId` links the visit to the inspection that fulfilled it, so a
/// planned day and the record of what happened are the same story rather than
/// two lists to reconcile by eye.
model ScheduledVisit {
  id          String      @id @default(cuid())
  centreId    String
  inspectorId String
  date        DateTime    @db.Date
  note        String?
  status      VisitStatus @default(PLANNED)
  /// Set once an inspection at this centre on this date is started.
  inspectionId String?    @unique
  /// Why the status was set by hand. Required when marking a visit missed: a
  /// mark against someone's name should never be a bare flag.
  statusReason String?
  /// Who set it by hand, and when. Null while the status is what the system
  /// worked out for itself, which is how the two are told apart.
  statusSetById String?
  statusSetAt   DateTime?
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  centre      Centre      @relation(fields: [centreId], references: [id], onDelete: Cascade)
  inspector   User        @relation("VisitInspector", fields: [inspectorId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation("VisitCreator", fields: [createdById], references: [id], onDelete: SetNull)
  statusSetBy User?       @relation("VisitStatusSetter", fields: [statusSetById], references: [id], onDelete: SetNull)
  inspection  Inspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)

  /// One booking per inspector per centre per day.
  @@unique([centreId, inspectorId, date])
  @@index([inspectorId, date])
  @@index([date, status])
}

/// A submitted report put in front of someone who runs the centre.
///
/// Written when an inspection is submitted, one row per person responsible for
/// that centre. It is what makes an inspection impossible to miss: unread rows
/// are the "new reports" count, and `readAt` records that it was actually
/// opened rather than merely sent.
model ReportDelivery {
  id           String    @id @default(cuid())
  inspectionId String
  userId       String
  deliveredAt  DateTime  @default(now())
  readAt       DateTime?

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([inspectionId, userId])
  @@index([userId, readAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}
