# The inspection app runs on its own database, separate from the Academy.
# With the bundled docker-compose (Postgres on 5434):
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/gotutors_inspection?schema=public"

# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET="REPLACE_WITH_RANDOM_HEX_32_BYTES"
NEXTAUTH_URL="http://localhost:3100"

# The first administrator, created by `npm run db:seed`.
# Set both, or the seed refuses to create an account.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Photo and signature storage. Default: local disk under public/uploads.
# UPLOAD_BACKEND=s3
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_PUBLIC_URL_BASE=
