# The inspection app runs on its own database, separate from the Academy.
# With the bundled docker-compose (Postgres on 5434):
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/gotutors_inspection?schema=public"

# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET="REPLACE_WITH_RANDOM_HEX_32_BYTES"
NEXTAUTH_URL="http://localhost:3100"

# The first administrator, created by `npm run db:seed`.
# Set both, or the seed refuses to create an account.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Where photos and signatures are kept.
#
# Unset, they go to local disk under public/uploads, which is fine for running
# the app on one machine. It is not fine in production: a container filesystem
# is wiped by every redeploy, and two instances behind a load balancer cannot
# see each other's files. Set UPLOAD_BACKEND=s3 for any real deployment.
#
# The bucket must be PRIVATE. The app streams images out of it through an
# authenticated route and never hands a bucket address to a browser, so nothing
# here needs public read.
#
# UPLOAD_BACKEND=s3
# S3_BUCKET=
# S3_REGION=eu-west-2
#
# Leave the keys unset on AWS: with no credentials in the environment the SDK
# uses the ECS task role or the EC2 instance role, and there is no long-lived
# secret to leak or rotate. Set them only for a store that has no role to
# assume — MinIO, or a machine outside AWS.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
#
# Only for an S3-compatible store that is not AWS (MinIO, Cloudflare R2).
# S3_ENDPOINT=

# ── Sending the report on ────────────────────────────────────────────────────
#
# Submitting an inspection emails the report, with the PDF attached, to whoever
# is responsible for that centre. Unset, messages are written to the log instead
# of being sent — right for a laptop, and refused at boot on a deployment, so a
# forgotten setting cannot quietly mean nobody was told.
#
# EMAIL_BACKEND=ses
# EMAIL_FROM="GoTutors Inspections <inspections@gotutors.com>"
# EMAIL_REPLY_TO=inspections@gotutors.com
#
# SES. Leave the keys unset on AWS to use the task role. The from-address must
# be a verified identity, and the account must be out of the SES sandbox or it
# can only send to addresses that have themselves been verified.
# SES_REGION=eu-west-2
# SES_CONFIGURATION_SET=          # so bounces and complaints reach someone
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
#
# Or any SMTP server, if you already have one.
# EMAIL_BACKEND=smtp
# SMTP_HOST=
# SMTP_PORT=587                   # 465 for implicit TLS, otherwise STARTTLS
# SMTP_USER=
# SMTP_PASSWORD=

# How many proxies sit in front of the app, for reading the caller's address out
# of X-Forwarded-For. 1 behind a single load balancer; 2 with CloudFront in
# front of one. Getting this wrong makes per-address rate limiting either
# useless or wrong.
# TRUSTED_PROXY_HOPS=1
