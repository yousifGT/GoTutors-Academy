# Copy to .env and fill in. .env is gitignored and must never be committed.

DATABASE_URL="postgresql://USER:PASS@HOST:5432/DB?schema=public"

# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET="REPLACE_WITH_RANDOM_HEX_32_BYTES"
NEXTAUTH_URL="https://your-domain.example"

# Automatic marking. Without this the app still runs, but every paper goes
# straight to the human queue and the dashboard says so.
ANTHROPIC_API_KEY=""

# Where photographed pages are stored. The default is local disk under
# public/uploads, which is fine for development and REFUSED in production —
# a container filesystem does not survive a deploy, and a lost paper cannot be
# recovered inside the product.
# UPLOAD_BACKEND=s3
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=              # for R2, MinIO and other S3-compatible providers
# S3_PUBLIC_URL_BASE=       # optional CDN base
