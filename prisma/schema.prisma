// GoTutors Academy — Prisma schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleType {
  SUPER_ADMIN
  CENTRE_ADMIN
  INSTRUCTOR
  TRAINEE
}

enum VideoProvider {
  UPLOAD
  YOUTUBE
  VIMEO
  LOOM
}

enum QuestionType {
  MULTIPLE_CHOICE
  OPEN_ENDED
}

enum NotificationType {
  TRAINEE_ENROLLED
  TRAINEE_PASSED
  TRAINEE_FAILED
  RETRY_UNLOCK_NEEDED
}

model Centre {
  id        String   @id @default(cuid())
  name      String
  location  String?
  /// Default size for inspections at this centre. Drives the size-based minimums
  /// and guidance in the checklist; an inspector can override it per visit.
  size      CentreSize?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  inspections Inspection[]
}

model Role {
  id            String       @id @default(cuid())
  name          String       @unique
  type          RoleType
  description   String?
  users         User[]
  permissions   RolePermission[]
  courses       CourseRoleAssignment[]
  subPositions  SubPosition[]
  createdAt     DateTime     @default(now())
}

model SubPosition {
  id        String   @id @default(cuid())
  roleId    String
  name      String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([roleId, name])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String?
  roles       RolePermission[]
  userOverrides UserPermissionOverride[]
}

model RolePermission {
  roleId       String
  permissionId String
  allowed      Boolean    @default(true)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model UserPermissionOverride {
  userId       String
  permissionId String
  allowed      Boolean
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([userId, permissionId])
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  password       String
  name           String
  position       String?
  subPosition    String?  @map("sub_position")
  isTrained      Boolean  @default(false) @map("is_trained")
  centreId       String?
  roleId         String
  supervisorId   String?
  active         Boolean  @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  centre         Centre?  @relation(fields: [centreId], references: [id])
  role           Role     @relation(fields: [roleId], references: [id])
  supervisor     User?    @relation("Supervisor", fields: [supervisorId], references: [id])
  reports        User[]   @relation("Supervisor")

  enrollments    Enrollment[]
  progress       Progress[]
  quizAttempts   QuizAttempt[]
  certificates   Certificate[]
  notifications  Notification[]    @relation("UserNotifications")
  authoredCourses Course[]         @relation("AuthoredCourses")
  inspections    Inspection[]      @relation("Inspections")
  permissionOverrides UserPermissionOverride[]

  @@index([centreId])
  @@index([roleId])
  @@index([supervisorId])
}

model Course {
  id            String   @id @default(cuid())
  title         String
  description   String?
  thumbnail     String?
  authorId      String
  passThreshold Int      @default(70)
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author        User     @relation("AuthoredCourses", fields: [authorId], references: [id])
  modules       Module[]
  enrollments   Enrollment[]
  certificates  Certificate[]
  roleAssignments CourseRoleAssignment[]

  @@index([authorId])
}

model CourseRoleAssignment {
  id          String  @id @default(cuid())
  courseId    String
  roleId      String
  subPosition String? @map("sub_position")
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  role        Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@unique([courseId, roleId, subPosition])
  @@index([roleId])
}

model Module {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  order     Int
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
}

model Lesson {
  id        String   @id @default(cuid())
  moduleId  String
  title     String
  content   String?
  order     Int
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  video     Video?
  quiz      Quiz?
  progress  Progress[]
}

model Video {
  id        String        @id @default(cuid())
  lessonId  String        @unique
  provider  VideoProvider
  url       String
  duration  Int           @default(0)
  lesson    Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Quiz {
  id            String   @id @default(cuid())
  lessonId      String   @unique
  passThreshold Int      @default(70)
  retryLimit    Int      @default(3)
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions     Question[]
  attempts      QuizAttempt[]
}

model Question {
  id       String       @id @default(cuid())
  quizId   String
  type     QuestionType
  prompt   String
  order    Int
  points   Int          @default(1)
  quiz     Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers  Answer[]
}

model Answer {
  id         String   @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean  @default(false)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())
  completed  Boolean  @default(false)
  completedAt DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([userId, courseId])
  @@index([courseId])
}

model Progress {
  id            String   @id @default(cuid())
  userId        String
  lessonId      String
  videoWatched  Boolean  @default(false)
  quizPassed    Boolean  @default(false)
  timeSpent     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  @@unique([userId, lessonId])
}

model QuizAttempt {
  id           String   @id @default(cuid())
  userId       String
  quizId       String
  score        Int
  passed       Boolean
  locked       Boolean  @default(false)
  needsReview  Boolean  @default(false)
  reviewedAt   DateTime?
  reviewedById String?
  reviewNote   String?
  createdAt    DateTime @default(now())
  answers      Json
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  @@index([userId, quizId])
}

model Certificate {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  issuedAt   DateTime @default(now())
  serial     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([userId, courseId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String?
  metadata  Json?
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([action])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  centreId  String?
  type      NotificationType
  title     String
  body      String?
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, read])
}

// ─────────────────────────────────────────────────────────────────────────────
// Centre inspections
//
// A separate product from the LMS that shares this database's Centre and User.
// The scoring rules live in inspection-app/core/inspection-core.js and are the
// one source of truth — see src/lib/inspection/score.ts for the bridge, and
// inspection-app/docs/BACKEND-HANDOFF.md for the original spec.
// ─────────────────────────────────────────────────────────────────────────────

enum CentreSize {
  SMALL
  MEDIUM
  LARGE
}

enum InspectionQuestionType {
  RATING
  YESNO
  SCALE
  NUMBER
  CHOICE
}

enum InspectionStatus {
  DRAFT
  SUBMITTED
}

/// Which part of the report an answered question lands in. Computed by the core
/// from the answer *and* the inspection's centre size — never store one without it.
enum InspectionBucket {
  WELL
  IMPROVE
  OBS
  SKIP
}

model InspectionTemplate {
  id          String   @id @default(cuid())
  name        String
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  sections    InspectionSection[]
  inspections Inspection[]

  @@unique([name, version])
  @@index([isActive])
}

model InspectionSection {
  id         String @id @default(cuid())
  templateId String
  title      String
  order      Int

  template   InspectionTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  questions  InspectionQuestion[]

  @@unique([templateId, order])
  @@index([templateId])
}

model InspectionQuestion {
  id          String                 @id @default(cuid())
  sectionId   String
  text        String
  type        InspectionQuestionType @default(RATING)
  order       Int
  /// choice: the selectable options, best-first when `scored`
  options     Json?
  /// scale bounds
  minVal      Int?
  maxVal      Int?
  /// number: what is being counted ("books", "passes")
  unit        String?
  /// a multiple choice that counts toward the score, first option best
  scored      Boolean                @default(false)
  requireNote Boolean                @default(false)
  /// failing this caps the whole inspection at "Serious finding"
  critical    Boolean                @default(false)
  /// a critical item evidenced in writing, not by photo (e.g. DBS records)
  photoExempt Boolean                @default(false)
  allowNA     Boolean                @default(false)
  /// each note entry carries a tutor name (the Teaching Observation sections)
  whoField    Boolean                @default(false)
  guide       String?
  /// green "do" bullets
  dos         Json?
  /// red "don't" bullets
  donts       Json?
  /// { small: { text }, medium: { text }, large: { text } }
  sizeGuide   Json?
  /// { small, medium, large } — a count below the target is flagged "improve"
  minBySize   Json?
  /// "standups" | "distractions" — driven by the session tally bar
  tallyKey    String?

  section InspectionSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  answers InspectionAnswer[]

  @@unique([sectionId, order])
  @@index([sectionId])
}

model Inspection {
  id          String           @id @default(cuid())
  centreId    String
  templateId  String
  inspectorId String
  /// the size used for THIS inspection — the centre default is only a starting point
  size        CentreSize
  date        DateTime         @db.Date
  startedAt   DateTime?
  endedAt     DateTime?
  /// accumulated ACTIVE milliseconds; the clock pauses when the inspector leaves
  activeMs    Int              @default(0)
  status      InspectionStatus @default(DRAFT)
  scorePct    Int?
  verdict     String?
  targets     String?

  debriefRole         String?
  debriefName         String?
  debriefNotes        String?
  debriefFeedback     String?
  debriefEmail        String?
  debriefSignatureUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  centre    Centre             @relation(fields: [centreId], references: [id])
  template  InspectionTemplate @relation(fields: [templateId], references: [id])
  inspector User               @relation("Inspections", fields: [inspectorId], references: [id])
  answers   InspectionAnswer[]

  @@index([centreId, date])
  @@index([inspectorId])
  @@index([status])
}

model InspectionAnswer {
  id            String  @id @default(cuid())
  inspectionId  String
  questionId    String
  /// snapshot of the question at answer time — the template may change later
  questionText  String
  /// "pass" | "yes" | "3" | "7" | "Positive" | "na" | null
  answer        String?
  /// from the core's itemScore, kept for analytics
  scoreFraction Float?
  bucket        InspectionBucket?

  inspection Inspection        @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  question   InspectionQuestion @relation(fields: [questionId], references: [id])
  entries    InspectionEntry[]

  @@unique([inspectionId, questionId])
  @@index([inspectionId])
  @@index([questionText, bucket])
}

/// Layered notes: one question can hold several entries, each tagged with the
/// tutor it came from and carrying its own photos.
model InspectionEntry {
  id       String @id @default(cuid())
  answerId String
  note     String?
  /// tutor name, for whoField questions
  who      String?
  order    Int    @default(0)

  answer InspectionAnswer  @relation(fields: [answerId], references: [id], onDelete: Cascade)
  photos InspectionPhoto[]

  @@index([answerId])
}

model InspectionPhoto {
  id      String   @id @default(cuid())
  entryId String
  url     String
  takenAt DateTime @default(now())

  entry InspectionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
}
